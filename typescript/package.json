{
  "name": "@lingolix/sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript client for the Lingolix pronunciation scoring API",
  "license": "MIT",
  "author": "Lingolix <info@lingolix.com>",
  "homepage": "https://lingolix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lingolix/lingolix-sdk.git",
    "directory": "typescript"
  },
  "bugs": "https://github.com/lingolix/lingolix-sdk/issues",
  "keywords": ["pronunciation", "speech", "language-learning", "ipa", "phonetics", "lingolix"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test 'test/*.test.mjs'"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
